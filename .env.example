# ===== CDK Instructor Wi-Fi portal - configuration =====================================
# Copy this file to ".env" and edit it. NEVER share or commit the real .env.

# --- Django ---------------------------------------------------------------------------
DEBUG=False
# A long random string. Generate one:  env\Scripts\python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
# Every name/IP the portal is reached by (the server's static IP, plus any hotspot DNS name)
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.88.5

# --- Database ---------------------------------------------------------------------------
# PostgreSQL (recommended). Create the user/database with docs\DEPLOYMENT_GUIDE.md, step 6.
DATABASE_URL=postgres://cdk_app:CHANGE_ME@127.0.0.1:5432/cdk_portal
# SQLite works for a quick trial:  DATABASE_URL=sqlite:///db.sqlite3

# --- MikroTik router ---------------------------------------------------------------------
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_USER=djangoapi
MIKROTIK_PASSWORD=change-me
MIKROTIK_HOTSPOT_SERVER=hotspot1
MIKROTIK_WAN_INTERFACE=ether1
MIKROTIK_TIMEOUT=5
# True = fake router (testing without hardware). MUST be False in production.
MIKROTIK_MOCK=False

# --- Portal address (the static IP of THIS server; add :port if not 80) --------------------
# Used for CSRF trust, for the services' port, and in the router's login.html
# Add a port (e.g. http://192.168.88.5:8088) if another app on this PC already uses port 80.
# After changing it: re-run scripts\install_services.ps1 AND update the router's hotspot/login.html redirect.
PORTAL_BASE_URL=http://192.168.88.5

# Only used by `manage.py seed_demo` (demo data). Do not run seed_demo for a real client.
SEED_ADMIN_PASSWORD=change-me-admin
